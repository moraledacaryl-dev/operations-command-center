ENVIRONMENT=local
SESSION_SECRET=change-this-local-secret
INTEGRATION_API_KEY=replace-with-shared-secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
RELEASE_SHA=development
DATABASE_URL=sqlite:////data/command_center.db
UPLOAD_DIR=/uploads
MAX_UPLOAD_BYTES=10485760
NEXT_PUBLIC_API_BASE=/api
# Optional for a manually started Next.js server; Compose/nginx route /api themselves.
OPERATIONS_API_ORIGIN=http://127.0.0.1:8200
ALLOW_DEMO_SEED=false
ALLOW_DEFAULT_ADMIN_BOOTSTRAP=false
LOCAL_SEED_PASSWORD=
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_NAME='Operations Owner'
BOOTSTRAP_OWNER_PASSWORD=replace-with-strong-owner-password
APP_BASE_PATH=/operations
PUBLIC_APP_URL=https://operations.hiddenoasis.app
ACCOUNTING_API_BASE_URL=https://accounting.hiddenoasis.app/api
POS_API_BASE_URL=https://pos.hiddenoasis.app/api
OPERATIONS_API_BASE_URL=https://operations.hiddenoasis.app/api
STAFF_PAYROLL_API_BASE_URL=https://staff.hiddenoasis.app
CORS_ORIGINS=https://hiddenoasis.app,https://operations.hiddenoasis.app

# Pass 2: preferred per-source keys for /api/integrations/v2.
# IMPORTANT: the entire JSON value MUST be shell quoted. Production deployment
# sources the environment file with Bash. Without single quotes, Bash removes
# JSON property/value quotes and the v2 integration credential preflight fails.
# Replace each placeholder with a distinct non-empty secret, and keep one line.
# Source-specific v2 credentials DO NOT fall back to INTEGRATION_API_KEY in production.
INTEGRATION_API_KEYS_JSON='{"hidden_oasis_staff_payroll":"replace-staff-key","accounting_program":"replace-accounting-key","dedicated_pos_cloud":"replace-pos-key","inventory_procurement":"replace-inventory-key"}'

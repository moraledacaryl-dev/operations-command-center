[Unit]
Description=Hidden Oasis Staff Payroll Streamlit
After=network.target

[Service]
User=root
WorkingDirectory=/root/hidden-oasis-staff-payroll
EnvironmentFile=/etc/hiddenoasis/staff-payroll.env
ExecStart=/root/hidden-oasis-staff-payroll/.venv/bin/streamlit run app.py --server.address 127.0.0.1 --server.port 8501 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

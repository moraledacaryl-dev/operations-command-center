[Unit]
Description=Hidden Oasis Fictional Operations Training API (isolated)
After=network.target
ConditionPathExists=/etc/hiddenoasis-training/training.env

[Service]
Type=simple
User=operations-training
Group=operations-training
WorkingDirectory=/opt/hiddenoasis-training/current/backend
EnvironmentFile=/etc/hiddenoasis-training/training.env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStart=/opt/hiddenoasis-training/current/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8401 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryHigh=280M
MemoryMax=384M
CPUQuota=65%
TasksMax=96
OOMScoreAdjust=700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/hiddenoasis-training

[Install]
WantedBy=multi-user.target

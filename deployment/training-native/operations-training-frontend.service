[Unit]
Description=Hidden Oasis Fictional Operations Training UI (isolated)
After=operations-training-backend.service
Requires=operations-training-backend.service
ConditionPathExists=/etc/hiddenoasis-training/training.env

[Service]
Type=simple
User=operations-training
Group=operations-training
WorkingDirectory=/opt/hiddenoasis-training/current/frontend/standalone
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3401
Environment=NEXT_PUBLIC_TRAINING_MODE=true
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=NODE_OPTIONS=--max-old-space-size=224
UMask=0077
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryHigh=256M
MemoryMax=384M
CPUQuota=65%
TasksMax=96
OOMScoreAdjust=700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/cache/hiddenoasis-training

[Install]
WantedBy=multi-user.target
